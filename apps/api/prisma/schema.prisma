generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  active
  inactive
  suspended
}

enum NotificationChannel {
  system
  sms
  email
  socket
}

enum SmsMessageStatus {
  queued
  sent
  failed
  skipped
}

enum CustomerType {
  residential
  business
  government
}

enum CustomerStatus {
  lead
  prospect
  active
  suspended
  disconnected
  terminated
}

enum CustomerAddressType {
  billing
  installation
}

enum SubscriptionStatus {
  active
  suspended
  cancelled
  terminated
}

enum MikrotikRouterStatus {
  active
  inactive
}

enum OltDeviceStatus {
  active
  inactive
  maintenance
}

enum OnuDeviceStatus {
  online
  offline
  los
  disabled
  pending
}

enum NetworkMonitorDeviceType {
  mikrotik_router
  olt_device
  onu_device
  switch_device
  other
}

enum SwitchVendor {
  mikrotik
  unifi
  edgeswitch
}

enum SwitchDeviceStatus {
  active
  inactive
  maintenance
}

enum NetworkMonitorMethod {
  icmp
  snmp
  manual
}

enum NetworkMonitorStatus {
  online
  degraded
  offline
  unknown
}

enum NetworkAlertSeverity {
  info
  warning
  critical
}

enum NetworkAlertStatus {
  open
  acknowledged
  resolved
  dismissed
}

enum NetworkAlertSource {
  monitoring
  manual
  system
}

enum InventoryItemType {
  material
  equipment
  consumable
  tool
}

enum InventoryMovementType {
  stock_in
  stock_out
  transfer
  return
}

enum InventoryAdjustmentType {
  increase
  decrease
  set
}

enum PurchaseRequestStatus {
  draft
  submitted
  approved
  rejected
  cancelled
}

enum PurchaseRequestPriority {
  low
  normal
  high
  urgent
}

enum PurchaseOrderStatus {
  draft
  issued
  partially_received
  received
  cancelled
}

enum GoodsReceiptStatus {
  received
  cancelled
}

enum OltPonTechnology {
  gpon
  epon
  xgpon
  xgspon
  xpon
}

enum SnmpVersion {
  v1
  v2c
  v3
}

enum PppoeAccountStatus {
  active
  suspended
  disabled
}

enum PppoeAccountActionType {
  enable
  disable
  suspend
  restore
  profile_change
}

enum PppoeSessionStatus {
  online
  offline
}

enum InstallationRequestStatus {
  pending
  scheduled
  in_progress
  completed
  cancelled
}

enum InstallationRequestPriority {
  low
  normal
  high
  urgent
}

enum BillingCycleStatus {
  draft
  open
  closed
  cancelled
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  overdue
  cancelled
}

enum InvoiceItemType {
  recurring_service
  installation_fee
  adjustment
  repair
  connector
  previous_balance
  other
}

enum PaymentMethod {
  cash
  gcash
  bank_transfer
  check
  card
  other
}

enum PaymentStatus {
  posted
  voided
}

enum ExpenseStatus {
  recorded
  voided
}

enum BillingAdjustmentType {
  credit
  charge
}

enum BillingAdjustmentStatus {
  posted
  voided
}

enum CollectionCaseStatus {
  pending
  contacted
  promised_to_pay
  escalated
  resolved
  cancelled
}

enum CollectionPriority {
  low
  normal
  high
  urgent
}

enum CollectorMobileEventType {
  payment
  collection_update
  visit_note
}

enum CollectorMobileEventStatus {
  accepted
  rejected
  duplicate
  adjusted
}

enum TicketStatus {
  open
  assigned
  in_progress
  resolved
  closed
  cancelled
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

enum TechnicianAssignmentStatus {
  assigned
  accepted
  in_progress
  completed
  cancelled
}

enum ProjectStatus {
  planning
  active
  on_hold
  completed
  cancelled
}

enum ProjectType {
  expansion
  backbone
  customer_install
  maintenance
  other
  cctv
  solar
  outsourced
}

enum ProjectEstimateStatus {
  draft
  approved
  rejected
  expired
}

enum ProjectBomStatus {
  draft
  approved
  issued
  cancelled
}

enum ProjectCostingStatus {
  draft
  final
}

enum MikrotikCommandStatus {
  mock_logged
  executed
  failed
  skipped
}

model User {
  id                Int                @id @default(autoincrement())
  name              String
  email             String             @unique
  mobileNumber      String?            @map("mobile_number")
  passwordHash      String             @map("password_hash")
  status            UserStatus         @default(active)
  lastLoginAt       DateTime?          @map("last_login_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  deletedAt         DateTime?          @map("deleted_at")
  roles             UserRole[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  createdCustomers  Customer[]         @relation("CustomerCreatedBy")
  uploadedDocuments CustomerDocument[]
  ticketAssignments TechnicianAssignment[]
  collectorPayments Payment[]          @relation("PaymentCollector")
  collectorCases    CollectionCase[]   @relation("CollectionCollector")
  installerRequests InstallationRequest[] @relation("InstallationInstaller")
  financeInvoices   Invoice[]          @relation("InvoiceFinanceReviewer")
  financeAdjustments BillingAdjustment[] @relation("AdjustmentFinanceReviewer")
  financePurchaseRequests PurchaseRequest[] @relation("PurchaseRequestFinanceReviewer")
  financeCollectionCases CollectionCase[] @relation("CollectionFinanceReviewer")
  contractorProjects Project[]          @relation("ProjectContractor")
  recordedExpenses   Expense[]           @relation("ExpenseRecordedBy")
  financeExpenses    Expense[]           @relation("ExpenseFinanceReviewer")
  pppoeAccountActions PppoeAccountActionLog[] @relation("PppoeActionPerformer")
  collectorMobileEvents CollectorMobileEvent[] @relation("CollectorMobileEvents")
  apiAccessTokens     ApiAccessToken[]
  sentSmsMessages     SmsMessage[]
  integrationSettings IntegrationSetting[] @relation("IntegrationSettingUpdatedBy")

  @@map("users")
}

model ApiAccessToken {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  label      String?
  deviceId   String?   @map("device_id")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@map("api_access_tokens")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  module      String
  action      String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  roleId    Int      @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  role      Role     @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int        @map("role_id")
  permissionId Int        @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  action      String
  module      String
  referenceId String?  @map("reference_id")
  oldValue    Json?    @map("old_value")
  newValue    Json?    @map("new_value")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Notification {
  id               Int                 @id @default(autoincrement())
  userId           Int?                @map("user_id")
  customerId       Int?                @map("customer_id")
  title            String
  message          String
  notificationType String              @map("notification_type")
  channel          NotificationChannel @default(system)
  isRead           Boolean             @default(false) @map("is_read")
  createdAt        DateTime            @default(now()) @map("created_at")
  user             User?               @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model SmsMessage {
  id                 Int              @id @default(autoincrement())
  recipient          String
  message            String           @db.Text
  senderName         String?          @map("sender_name")
  status             SmsMessageStatus @default(queued)
  semaphoreMessageId String?          @map("semaphore_message_id")
  semaphoreStatus    String?          @map("semaphore_status")
  network            String?
  errorMessage       String?          @map("error_message") @db.Text
  customerId         Int?             @map("customer_id")
  sentByUserId       Int?             @map("sent_by_user_id")
  notificationType   String?          @map("notification_type")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  customer           Customer?        @relation(fields: [customerId], references: [id])
  sentBy             User?            @relation(fields: [sentByUserId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("sms_messages")
}

model IntegrationSetting {
  id              Int      @id @default(autoincrement())
  key             String   @unique
  valueEncrypted  String?  @map("value_encrypted") @db.Text
  valuePlain      String?  @map("value_plain") @db.Text
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedByUserId Int?     @map("updated_by_user_id")
  updatedBy       User?    @relation("IntegrationSettingUpdatedBy", fields: [updatedByUserId], references: [id])

  @@map("integration_settings")
}

model Customer {
  id                   Int                @id @default(autoincrement())
  accountNumber        String             @unique @map("account_number")
  customerType         CustomerType       @map("customer_type")
  firstName            String?            @map("first_name")
  lastName             String?            @map("last_name")
  businessName         String?            @map("business_name")
  email                String?
  mobileNumber         String             @map("mobile_number")
  birthDate            DateTime?          @map("birth_date") @db.Date
  status               CustomerStatus     @default(lead)
  referredByCustomerId Int?               @map("referred_by_customer_id")
  createdByUserId      Int                @map("created_by_user_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  deletedAt            DateTime?          @map("deleted_at")
  createdBy            User               @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id])
  referredByCustomer   Customer?          @relation("CustomerReferrals", fields: [referredByCustomerId], references: [id])
  referredCustomers    Customer[]         @relation("CustomerReferrals")
  addresses            CustomerAddress[]
  documents            CustomerDocument[]
  subscriptions        Subscription[]
  pppoeAccounts        PppoeAccount[]
  onuDevices           OnuDevice[]
  installationRequests InstallationRequest[]
  invoices             Invoice[]
  payments             Payment[]
  billingAdjustments   BillingAdjustment[]
  collectionCases      CollectionCase[]
  tickets              Ticket[]
  projects             Project[]
  pppoeAccountActions  PppoeAccountActionLog[]
  smsMessages          SmsMessage[]

  @@map("customers")
}

model CustomerAddress {
  id           Int                 @id @default(autoincrement())
  customerId   Int                 @map("customer_id")
  barangayId   Int?                @map("barangay_id")
  addressType  CustomerAddressType @map("address_type")
  street       String
  barangay     String
  municipality String
  province     String
  latitude     Decimal?            @db.Decimal(10, 7)
  longitude    Decimal?            @db.Decimal(10, 7)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  customer     Customer            @relation(fields: [customerId], references: [id])
  barangayRef  Barangay?           @relation(fields: [barangayId], references: [id])

  @@map("customer_addresses")
}

model CustomerDocument {
  id               Int      @id @default(autoincrement())
  customerId       Int      @map("customer_id")
  documentType     String   @map("document_type")
  filePath         String   @map("file_path")
  uploadedByUserId Int      @map("uploaded_by_user_id")
  createdAt        DateTime @default(now()) @map("created_at")
  customer         Customer @relation(fields: [customerId], references: [id])
  uploadedBy       User     @relation(fields: [uploadedByUserId], references: [id])

  @@map("customer_documents")
}

model Province {
  id             Int            @id @default(autoincrement())
  name           String         @unique
  code           String?        @unique
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  municipalities Municipality[]

  @@map("provinces")
}

model Municipality {
  id         Int        @id @default(autoincrement())
  provinceId Int        @map("province_id")
  name       String
  code       String?    @unique
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  province   Province   @relation(fields: [provinceId], references: [id])
  barangays  Barangay[]

  @@unique([provinceId, name])
  @@map("municipalities")
}

model Barangay {
  id             Int               @id @default(autoincrement())
  municipalityId Int               @map("municipality_id")
  name           String
  code           String?           @unique
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  municipality   Municipality      @relation(fields: [municipalityId], references: [id])
  addresses      CustomerAddress[]

  @@unique([municipalityId, name])
  @@map("barangays")
}

model ServicePlan {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  description  String?
  downloadMbps Int      @map("download_mbps")
  uploadMbps   Int      @map("upload_mbps")
  monthlyPrice      Decimal   @map("monthly_price") @db.Decimal(10, 2)
  pppoeProfileName  String?   @map("pppoe_profile_name")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  subscriptions Subscription[]
  pppoeAccounts   PppoeAccount[]
  installationRequests InstallationRequest[]
  invoiceItems         InvoiceItem[]

  @@map("service_plans")
}

model InstallationRequest {
  id                    Int                         @id @default(autoincrement())
  customerId            Int                         @map("customer_id")
  servicePlanId         Int?                        @map("service_plan_id")
  status                InstallationRequestStatus   @default(pending)
  priority              InstallationRequestPriority @default(normal)
  requestedDate         DateTime                    @default(now()) @map("requested_date") @db.Date
  scheduledDate         DateTime?                   @map("scheduled_date")
  completedAt           DateTime?                   @map("completed_at")
  assignedInstallerName   String?                     @map("assigned_installer_name")
  assignedInstallerUserId Int?                        @map("assigned_installer_user_id")
  contactNumber           String?                     @map("contact_number")
  installationAddress     String                      @map("installation_address") @db.Text
  mapLocation             String?                     @map("map_location")
  notes                   String?                     @db.Text
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")
  deletedAt               DateTime?                   @map("deleted_at")
  customer                Customer                    @relation(fields: [customerId], references: [id])
  servicePlan               ServicePlan?                @relation(fields: [servicePlanId], references: [id])
  assignedInstaller         User?                       @relation("InstallationInstaller", fields: [assignedInstallerUserId], references: [id])

  @@map("installation_requests")
}

model BillingCycle {
  id          Int                @id @default(autoincrement())
  name        String
  periodStart DateTime           @map("period_start") @db.Date
  periodEnd   DateTime           @map("period_end") @db.Date
  dueDate     DateTime           @map("due_date") @db.Date
  status      BillingCycleStatus @default(draft)
  notes       String?            @db.Text
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  deletedAt   DateTime?          @map("deleted_at")
  invoices    Invoice[]

  @@unique([periodStart, periodEnd])
  @@map("billing_cycles")
}

model Subscription {
  id                 Int                @id @default(autoincrement())
  customerId         Int                @map("customer_id")
  servicePlanId      Int                @map("service_plan_id")
  pppoeAccountId     Int?               @map("pppoe_account_id")
  billingDay         Int                @map("billing_day")
  startDate          DateTime           @map("start_date") @db.Date
  endDate            DateTime?          @map("end_date") @db.Date
  status             SubscriptionStatus @default(active)
  autoSuspendEnabled Boolean            @default(true) @map("auto_suspend_enabled")
  gracePeriodDays    Int                @default(7) @map("grace_period_days")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  customer           Customer           @relation(fields: [customerId], references: [id])
  servicePlan        ServicePlan        @relation(fields: [servicePlanId], references: [id])
  pppoeAccount       PppoeAccount?      @relation(fields: [pppoeAccountId], references: [id])
  invoices           Invoice[]
  onuDevices         OnuDevice[]
  tickets            Ticket[]

  @@map("subscriptions")
}

model Invoice {
  id             Int           @id @default(autoincrement())
  invoiceNumber  String        @unique @map("invoice_number")
  billingCycleId Int           @map("billing_cycle_id")
  customerId     Int           @map("customer_id")
  subscriptionId Int?          @map("subscription_id")
  issueDate      DateTime      @map("issue_date") @db.Date
  dueDate        DateTime      @map("due_date") @db.Date
  subtotal       Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @default(0) @db.Decimal(10, 2)
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(10, 2)
  balance        Decimal       @default(0) @db.Decimal(10, 2)
  status                InvoiceStatus @default(draft)
  notes                 String?       @db.Text
  assignedFinanceUserId Int?          @map("assigned_finance_user_id")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")
  billingCycle          BillingCycle  @relation(fields: [billingCycleId], references: [id])
  customer              Customer      @relation(fields: [customerId], references: [id])
  subscription          Subscription? @relation(fields: [subscriptionId], references: [id])
  assignedFinanceUser   User?         @relation("InvoiceFinanceReviewer", fields: [assignedFinanceUserId], references: [id])
  items          InvoiceItem[]
  payments       Payment[]
  adjustments    BillingAdjustment[]
  collectionCase CollectionCase?
  pppoeAccountActions PppoeAccountActionLog[]

  @@unique([billingCycleId, subscriptionId])
  @@map("invoices")
}

model InvoiceItem {
  id            Int             @id @default(autoincrement())
  invoiceId     Int             @map("invoice_id")
  servicePlanId Int?            @map("service_plan_id")
  itemType      InvoiceItemType @default(recurring_service) @map("item_type")
  description   String
  quantity      Decimal         @default(1) @db.Decimal(10, 2)
  unitPrice     Decimal         @map("unit_price") @db.Decimal(10, 2)
  amount        Decimal         @db.Decimal(10, 2)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  invoice       Invoice         @relation(fields: [invoiceId], references: [id])
  servicePlan   ServicePlan?    @relation(fields: [servicePlanId], references: [id])

  @@map("invoice_items")
}

model Payment {
  id              Int           @id @default(autoincrement())
  paymentNumber   String        @unique @map("payment_number")
  invoiceId       Int           @map("invoice_id")
  customerId      Int           @map("customer_id")
  amount          Decimal       @db.Decimal(10, 2)
  paymentDate     DateTime      @map("payment_date") @db.Date
  paymentMethod   PaymentMethod @map("payment_method")
  referenceNumber String?       @map("reference_number")
  receivedBy      String?       @map("received_by")
  collectorUserId Int?          @map("collector_user_id")
  status          PaymentStatus @default(posted)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  customer        Customer      @relation(fields: [customerId], references: [id])
  collector       User?         @relation("PaymentCollector", fields: [collectorUserId], references: [id])
  pppoeAccountActions PppoeAccountActionLog[]
  collectorMobileEvents CollectorMobileEvent[]

  @@map("payments")
}

model BillingAdjustment {
  id               Int                     @id @default(autoincrement())
  adjustmentNumber String                  @unique @map("adjustment_number")
  invoiceId        Int                     @map("invoice_id")
  customerId       Int                     @map("customer_id")
  adjustmentType   BillingAdjustmentType   @map("adjustment_type")
  amount           Decimal                 @db.Decimal(10, 2)
  reason           String
  adjustmentDate   DateTime                @map("adjustment_date") @db.Date
  status                BillingAdjustmentStatus @default(posted)
  notes                 String?                 @db.Text
  assignedFinanceUserId Int?                    @map("assigned_finance_user_id")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  deletedAt             DateTime?               @map("deleted_at")
  invoice               Invoice                 @relation(fields: [invoiceId], references: [id])
  customer              Customer                @relation(fields: [customerId], references: [id])
  assignedFinanceUser   User?                   @relation("AdjustmentFinanceReviewer", fields: [assignedFinanceUserId], references: [id])

  @@map("billing_adjustments")
}

model CollectionCase {
  id                Int                  @id @default(autoincrement())
  invoiceId         Int                  @unique @map("invoice_id")
  customerId        Int                  @map("customer_id")
  status            CollectionCaseStatus @default(pending)
  priority          CollectionPriority   @default(normal)
  assignedCollector         String?              @map("assigned_collector")
  assignedCollectorUserId   Int?                 @map("assigned_collector_user_id")
  lastContactedAt           DateTime?            @map("last_contacted_at")
  nextFollowUpDate          DateTime?            @map("next_follow_up_date") @db.Date
  promiseToPayDate          DateTime?            @map("promise_to_pay_date") @db.Date
  notes                     String?              @db.Text
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  deletedAt                 DateTime?            @map("deleted_at")
  invoice                   Invoice              @relation(fields: [invoiceId], references: [id])
  customer                  Customer             @relation(fields: [customerId], references: [id])
  assignedCollectorUser       User?                @relation("CollectionCollector", fields: [assignedCollectorUserId], references: [id])
  assignedFinanceUserId       Int?                 @map("assigned_finance_user_id")
  assignedFinanceUser         User?                @relation("CollectionFinanceReviewer", fields: [assignedFinanceUserId], references: [id])
  collectorMobileEvents       CollectorMobileEvent[]

  @@map("collection_cases")
}

model CollectorMobileEvent {
  id               Int                        @id @default(autoincrement())
  localId          String                     @unique @map("local_id")
  collectorUserId  Int                        @map("collector_user_id")
  deviceId         String                     @map("device_id")
  eventType        CollectorMobileEventType   @map("event_type")
  eventPayload     Json                       @map("event_payload")
  resultStatus     CollectorMobileEventStatus @map("result_status")
