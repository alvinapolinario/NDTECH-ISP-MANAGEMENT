  id                  Int               @id @default(autoincrement())
  goodsReceiptId      Int               @map("goods_receipt_id")
  purchaseOrderItemId Int               @map("purchase_order_item_id")
  itemId              Int               @map("item_id")
  quantityReceived    Decimal           @map("quantity_received") @db.Decimal(12, 2)
  unitCost            Decimal           @map("unit_cost") @db.Decimal(12, 2)
  notes               String?           @db.Text
  createdAt           DateTime          @default(now()) @map("created_at")
  goodsReceipt        GoodsReceipt      @relation(fields: [goodsReceiptId], references: [id])
  purchaseOrderItem   PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id])
  item                InventoryItem     @relation(fields: [itemId], references: [id])

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([itemId])
  @@map("goods_receipt_items")
}

model TicketCategory {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  tickets     Ticket[]

  @@map("ticket_categories")
}

model Ticket {
  id             Int            @id @default(autoincrement())
  ticketNumber   String         @unique @map("ticket_number")
  customerId     Int?           @map("customer_id")
  subscriptionId Int?           @map("subscription_id")
  categoryId     Int            @map("category_id")
  subject        String
  description    String         @db.Text
  status         TicketStatus   @default(open)
  priority       TicketPriority @default(normal)
  reportedBy     String?        @map("reported_by")
  contactNumber  String?        @map("contact_number")
  location       String?        @db.Text
  dueAt          DateTime?      @map("due_at")
  resolvedAt     DateTime?      @map("resolved_at")
  resolution     String?        @db.Text
  notes          String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  deletedAt      DateTime?      @map("deleted_at")
  customer       Customer?      @relation(fields: [customerId], references: [id])
  subscription   Subscription?  @relation(fields: [subscriptionId], references: [id])
  category       TicketCategory @relation(fields: [categoryId], references: [id])
  assignments    TechnicianAssignment[]

  @@index([customerId])
  @@index([subscriptionId])
  @@index([categoryId])
  @@map("tickets")
}

model TechnicianAssignment {
  id             Int                         @id @default(autoincrement())
  ticketId       Int                         @map("ticket_id")
  technicianId   Int                         @map("technician_id")
  status         TechnicianAssignmentStatus  @default(assigned)
  scheduledAt    DateTime?                   @map("scheduled_at")
  startedAt      DateTime?                   @map("started_at")
  completedAt    DateTime?                   @map("completed_at")
  notes          String?                     @db.Text
  completionNotes String?                    @map("completion_notes") @db.Text
  createdAt      DateTime                    @default(now()) @map("created_at")
  updatedAt      DateTime                    @updatedAt @map("updated_at")
  deletedAt      DateTime?                   @map("deleted_at")
  ticket         Ticket                      @relation(fields: [ticketId], references: [id])
  technician     User                        @relation(fields: [technicianId], references: [id])

  @@index([ticketId])
  @@index([technicianId])
  @@map("technician_assignments")
}

model Project {
  id              Int                    @id @default(autoincrement())
  code            String                 @unique
  name            String
  description     String?                @db.Text
  projectType     ProjectType            @default(expansion) @map("project_type")
  status          ProjectStatus          @default(planning)
  customerId      Int?                   @map("customer_id")
  location        String?                @db.Text
  startDate       DateTime?              @map("start_date") @db.Date
  targetDate      DateTime?              @map("target_date") @db.Date
  completedAt     DateTime?              @map("completed_at")
  budget            Decimal                @default(0) @db.Decimal(12, 2)
  managerName       String?                @map("manager_name")
  contractorUserId  Int?                   @map("contractor_user_id")
  notes             String?                @db.Text
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  deletedAt         DateTime?              @map("deleted_at")
  customer          Customer?              @relation(fields: [customerId], references: [id])
  contractor        User?                  @relation("ProjectContractor", fields: [contractorUserId], references: [id])
  estimates       ProjectEstimate[]
  boms            ProjectBom[]
  materialUsages  ProjectMaterialUsage[]
  costing         ProjectCosting?

  @@index([customerId])
  @@map("projects")
}

model ProjectEstimate {
  id             Int                   @id @default(autoincrement())
  projectId      Int                   @map("project_id")
  estimateNumber String                @unique @map("estimate_number")
  status         ProjectEstimateStatus @default(draft)
  validUntil     DateTime?             @map("valid_until") @db.Date
  laborCost      Decimal               @default(0) @map("labor_cost") @db.Decimal(12, 2)
  overheadCost   Decimal               @default(0) @map("overhead_cost") @db.Decimal(12, 2)
  notes          String?               @db.Text
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  deletedAt      DateTime?             @map("deleted_at")
  project        Project               @relation(fields: [projectId], references: [id])
  items          ProjectEstimateItem[]

  @@index([projectId])
  @@map("project_estimates")
}

model ProjectEstimateItem {
  id              Int             @id @default(autoincrement())
  estimateId      Int             @map("estimate_id")
  itemId          Int?            @map("item_id")
  description     String
  quantity        Decimal         @db.Decimal(12, 2)
  unit            String          @default("pcs")
  unitCost        Decimal         @map("unit_cost") @db.Decimal(12, 2)
  notes           String?         @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")
  estimate        ProjectEstimate @relation(fields: [estimateId], references: [id])
  item            InventoryItem?  @relation(fields: [itemId], references: [id])

  @@index([estimateId])
  @@index([itemId])
  @@map("project_estimate_items")
}

model ProjectBom {
  id        Int              @id @default(autoincrement())
  projectId Int              @map("project_id")
  bomNumber String           @unique @map("bom_number")
  status    ProjectBomStatus @default(draft)
  notes     String?          @db.Text
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")
  project   Project          @relation(fields: [projectId], references: [id])
  items     ProjectBomItem[]

  @@index([projectId])
  @@map("project_boms")
}

model ProjectBomItem {
  id                Int           @id @default(autoincrement())
  bomId             Int           @map("bom_id")
  itemId            Int           @map("item_id")
  quantity          Decimal       @db.Decimal(12, 2)
  estimatedUnitCost Decimal       @default(0) @map("estimated_unit_cost") @db.Decimal(12, 2)
  notes             String?       @db.Text
  createdAt         DateTime      @default(now()) @map("created_at")
  bom               ProjectBom    @relation(fields: [bomId], references: [id])
  item              InventoryItem @relation(fields: [itemId], references: [id])

  @@index([bomId])
  @@index([itemId])
  @@map("project_bom_items")
}

model ProjectMaterialUsage {
  id          Int                        @id @default(autoincrement())
  projectId   Int                        @map("project_id")
  warehouseId Int                        @map("warehouse_id")
  usageNumber String                     @unique @map("usage_number")
  usedDate    DateTime                   @default(now()) @map("used_date") @db.Date
  usedBy      String?                    @map("used_by")
  notes       String?                    @db.Text
  createdAt   DateTime                   @default(now()) @map("created_at")
  updatedAt   DateTime                   @updatedAt @map("updated_at")
  deletedAt   DateTime?                  @map("deleted_at")
  project     Project                    @relation(fields: [projectId], references: [id])
  warehouse   Warehouse                  @relation(fields: [warehouseId], references: [id])
  items       ProjectMaterialUsageItem[]

  @@index([projectId])
  @@index([warehouseId])
  @@map("project_material_usages")
}

model ProjectMaterialUsageItem {
  id              Int                  @id @default(autoincrement())
  materialUsageId Int                  @map("material_usage_id")
  itemId          Int                  @map("item_id")
  quantity        Decimal              @db.Decimal(12, 2)
  unitCost        Decimal              @default(0) @map("unit_cost") @db.Decimal(12, 2)
  notes           String?              @db.Text
  createdAt       DateTime             @default(now()) @map("created_at")
  materialUsage   ProjectMaterialUsage @relation(fields: [materialUsageId], references: [id])
  item            InventoryItem        @relation(fields: [itemId], references: [id])

  @@index([materialUsageId])
  @@index([itemId])
  @@map("project_material_usage_items")
}

model ProjectCosting {
  id           Int                  @id @default(autoincrement())
  projectId    Int                  @unique @map("project_id")
  status       ProjectCostingStatus @default(draft)
  laborCost    Decimal              @default(0) @map("labor_cost") @db.Decimal(12, 2)
  overheadCost Decimal              @default(0) @map("overhead_cost") @db.Decimal(12, 2)
  otherCost    Decimal              @default(0) @map("other_cost") @db.Decimal(12, 2)
  notes        String?              @db.Text
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")
  project      Project              @relation(fields: [projectId], references: [id])

  @@map("project_costings")
}

model ExpenseCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  expenses    Expense[]

  @@map("expense_categories")
}

model Expense {
  id                    Int             @id @default(autoincrement())
  expenseNumber         String          @unique @map("expense_number")
  expenseCategoryId     Int             @map("expense_category_id")
  supplierId            Int?            @map("supplier_id")
  expenseDate           DateTime        @map("expense_date") @db.Date
  amount                Decimal         @db.Decimal(12, 2)
  payee                 String
  paymentMethod         PaymentMethod   @map("payment_method")
  referenceNumber       String?         @map("reference_number")
  description           String          @db.Text
  notes                 String?         @db.Text
  status                ExpenseStatus   @default(recorded)
  recordedByUserId      Int?            @map("recorded_by_user_id")
  assignedFinanceUserId Int?            @map("assigned_finance_user_id")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  deletedAt             DateTime?       @map("deleted_at")
  category              ExpenseCategory @relation(fields: [expenseCategoryId], references: [id])
  supplier              Supplier?       @relation(fields: [supplierId], references: [id])
  recordedBy            User?           @relation("ExpenseRecordedBy", fields: [recordedByUserId], references: [id])
  assignedFinanceUser   User?           @relation("ExpenseFinanceReviewer", fields: [assignedFinanceUserId], references: [id])

  @@index([expenseCategoryId])
  @@index([supplierId])
  @@index([expenseDate])
  @@map("expenses")
}
