# Copy to .env.docker (not used by native Windows development):
#   copy .env.docker.example .env.docker

DOCKER_ENV=true

# -----------------------------------------------------------------------------
# MySQL (Docker service name: mysql)
# Host port 3308 -> container 3306 (native Windows MySQL can keep 3306)
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=isp_docker_root
MYSQL_DATABASE=isp_billing
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
DATABASE_URL=mysql://root:isp_docker_root@mysql:3306/isp_billing

# -----------------------------------------------------------------------------
# Redis (optional — included for future use, app does not require it yet)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# App ports (published to the Docker host)
# -----------------------------------------------------------------------------
API_PORT=4000
WEB_PORT=3001

# -----------------------------------------------------------------------------
# Web UI (nginx path-based routing on port 80)
# Access: http://10.250.106.199/isp-billing/ or http://172.27.201.182/isp-billing/
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BASE_PATH=/isp-billing
NEXT_PUBLIC_API_URL=/isp-billing/backend
NEXT_PUBLIC_SOCKET_URL=/isp-billing/backend

# Mobile collector / direct API (port 4000, not behind nginx path):
# NEXT_PUBLIC_API_URL=http://10.250.106.199:4000
# NEXT_PUBLIC_SOCKET_URL=http://10.250.106.199:4000
# ZeroTier: http://172.27.201.182:4000

# -----------------------------------------------------------------------------
# Auth / integrations
# -----------------------------------------------------------------------------
JWT_SECRET=change_this_docker_jwt_secret
MIKROTIK_SECRET_KEY=change_this_docker_mikrotik_secret
MIKROTIK_USE_MOCK=true

# NDRadius / FreeRADIUS (host MariaDB — default port 3307 when published from NDRadius stack)
# RADIUS_DB_HOST=host.docker.internal
# RADIUS_DB_PORT=3307
# RADIUS_DB_NAME=radius
# RADIUS_DB_USER=radius
# RADIUS_DB_PASSWORD=radiuspass
# RADIUS_PROVISION_ENABLED=true
# RADIUS_SUSPENDED_GROUP=suspended
# RADIUS_COA_ENABLED=true
# RADIUS_COA_PORT=3799
# RADIUS_COA_TIMEOUT_MS=3000
# RADIUS_DEFAULT_NAS_SECRET=radiussecret

SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=NDTECH
SMS_ENABLED=false

# Payment gateways (PayMongo first; Maya/GCash/Stripe stubs ready)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_ENABLED=false
PAYMENT_GATEWAY_DEFAULT=paymongo
# Public URL for webhook registration in PayMongo dashboard, e.g. https://your-domain/isp-billing/backend
PAYMENT_GATEWAY_WEBHOOK_BASE_URL=

# GenieACS TR-069 (stack in /root/GenieACS — docker compose up -d)
GENIEACS_ENABLED=true
GENIEACS_NBI_URL=http://host.docker.internal:7557
GENIEACS_CWMP_URL=http://172.27.201.182:7547/

