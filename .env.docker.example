# Copy to .env.docker (not used by native Windows development):
#   copy .env.docker.example .env.docker

DOCKER_ENV=true

# -----------------------------------------------------------------------------
# MySQL (Docker service name: mysql)
# Host port 3308 -> container 3306 (native Windows MySQL can keep 3306)
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=isp_docker_root
MYSQL_DATABASE=isp_billing
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
DATABASE_URL=mysql://root:isp_docker_root@mysql:3306/isp_billing

# -----------------------------------------------------------------------------
# Redis (optional — included for future use, app does not require it yet)
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# App ports (published to the Docker host)
# -----------------------------------------------------------------------------
API_PORT=4000
WEB_PORT=3001

# -----------------------------------------------------------------------------
# API URL for browsers and the Flutter collector app
# Primary: Ubuntu dry-run server on your LAN
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://10.250.106.199:4000
NEXT_PUBLIC_SOCKET_URL=http://10.250.106.199:4000

# ZeroTier remote testing (uncomment and comment the lines above when needed):
# NEXT_PUBLIC_API_URL=http://172.27.201.182:4000
# NEXT_PUBLIC_SOCKET_URL=http://172.27.201.182:4000

# -----------------------------------------------------------------------------
# Auth / integrations
# -----------------------------------------------------------------------------
JWT_SECRET=change_this_docker_jwt_secret
MIKROTIK_SECRET_KEY=change_this_docker_mikrotik_secret
MIKROTIK_USE_MOCK=true

SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=NDTECH
SMS_ENABLED=false

# Set to false after the first successful seed to skip seed on API restarts
RUN_DB_SEED=true
